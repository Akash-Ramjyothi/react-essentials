# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =================================
#  Dependencies
# =================================
/node_modules
/.pnp
.pnp.js
.pnp.loader.mjs

# =================================
#  Build outputs
# =================================
/build
/dist
/out
*.tsbuildinfo

# =================================
#  Environment files (sensitive)
# =================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# =================================
#  Testing
# =================================
/coverage
.nyc_output
*.test-results.json

# =================================
#  Logs
# =================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# =================================
#  OS / system files
# =================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# =================================
#  IDE / Editor files
# =================================
# VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.history/
*.code-workspace

# IntelliJ / WebStorm / JetBrains
.idea/
*.iml
*.iws
*.ipr
out/

# Vim
*.swp
*.swo
*~

# Emacs
*~

# =================================
#  Cache / temporary files
# =================================
.cache/
.parcel-cache/
*.tmp
*.temp

# =================================
#  Misc
# =================================
# Optional: if you use Sentry or other tools
.sentry/
# Optional: if you use Docker
docker-compose.override.yml
# Optional: if you use dotenv for custom scripts, you might add:
.env.*.local
